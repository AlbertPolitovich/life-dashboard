[Unit]
Description=life-dashboard Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lifebot
Group=lifebot
WorkingDirectory=/opt/life-dashboard/bot
EnvironmentFile=/opt/life-dashboard/bot/.env
# Часовой пояс для напоминаний 🔔 (подставь свой, напр. Europe/Moscow)
Environment=TZ=Europe/Moscow
ExecStart=/opt/life-dashboard/bot/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
