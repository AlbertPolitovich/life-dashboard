{
  "log": { "level": "warn" },
  "dns": {
    "servers": [
      { "type": "udp", "tag": "cf", "server": "1.1.1.1" },
      { "type": "local", "tag": "local" }
    ],
    "rules": [
      { "domain": ["dash.svodbot.ru", "svodbot.ru"], "server": "local" }
    ],
    "final": "cf",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "0.0.0.0",
      "listen_port": 7895,
      "network": "tcp",
      "sniff": true,
      "sniff_override_destination": true
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in-udp",
      "listen": "0.0.0.0",
      "listen_port": 7895,
      "network": "udp",
      "sniff": true,
      "sniff_override_destination": true
    }
  ],
  "outbounds": [
    { "type": "direct", "tag": "direct", "domain_strategy": "ipv4_only" },
    { "type": "direct", "tag": "nl-exit", "bind_interface": "wg-nl", "domain_strategy": "ipv4_only" }
  ],
  "route": {
    "rule_set": [
      {
        "tag": "geoip-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-ru.srs",
        "download_detour": "direct"
      },
      {
        "tag": "geosite-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ru.srs",
        "download_detour": "direct"
      }
    ],
    "rules": [
      { "ip_is_private": true, "outbound": "direct" },
      { "rule_set": "geoip-ru", "outbound": "direct" },
      { "rule_set": "geosite-ru", "outbound": "direct" },
      { "domain": ["dash.svodbot.ru", "svodbot.ru"], "outbound": "direct" }
    ],
    "final": "nl-exit",
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": { "enabled": true, "path": "/var/lib/sing-box/cache.db" }
  }
}
